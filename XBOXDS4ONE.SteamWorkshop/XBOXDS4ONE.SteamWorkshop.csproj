<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>XBOXDS4ONE.SteamWorkshop</RootNamespace>
    <AssemblyName>XBOXDS4ONE.SteamWorkshop</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Linking ..\SharedVersion.cs provides AssemblyVersion + AssemblyFileVersion,
         so the SDK must not also emit them. Mirrors XBOXDS4ONE.Engine. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Windows-only by design (same platform floor as the rest of the solution).
         The Steam clients touch the registry (legacy local-cache discovery lands
         in a later phase) and the cache lives under %LOCALAPPDATA%. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <Product>XBOXDS4ONE</Product>
    <Company>XBOXDS4ONE</Company>
    <Copyright>Copyright © XBOXDS4ONE Contributors</Copyright>
    <Description>XBOXDS4ONE Steam Workshop client. SteamKit2 anonymous CM session, direct Steam HTTPS clients, Steam Input VDF parser, typed config model, and file-system cache.</Description>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Steam protocol client (LGPL-2.1-only). Pinned exactly: Valve adjusts the
         Steam protocol periodically and SteamKit2 catches up in point releases;
         an unpinned range would silently drift the wire contract. -->
    <PackageReference Include="SteamKit2" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XBOXDS4ONE.Engine\XBOXDS4ONE.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared AssemblyVersion + AssemblyFileVersion. Single source of truth
         across XBOXDS4ONE.App, XBOXDS4ONE.Engine, and XBOXDS4ONE.SteamWorkshop. -->
    <Compile Include="..\SharedVersion.cs" Link="Properties\SharedVersion.cs" />
  </ItemGroup>

</Project>
